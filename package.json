{
  "name": "riber-captacion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "size-limit",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "dev:lan": "vite --host --mode lan --port 5173 --strictPort",
    "tunnel:serve": "tsc -b && vite build --mode tunnel && vite preview --mode tunnel --port 4173 --strictPort",
    "tunnel": "cloudflared tunnel --url http://localhost:4173",
    "db:clean": "docker exec -i supabase_db_riber-captacion psql -U postgres -v ON_ERROR_STOP=1 -q < supabase/scripts/clean-test-data.sql",
    "db:demo": "docker exec -i supabase_db_riber-captacion psql -U postgres -v ON_ERROR_STOP=1 -q < supabase/scripts/demo-data.sql"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@supabase/auth-js": "2.118.0",
    "@supabase/postgrest-js": "2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-router": "^1.170.46",
    "dexie": "^4.4.7",
    "exceljs": "4.4.0",
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/preset-app": "^14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^16.0.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild"
    ]
  }
}
