# Valores que imprime `pnpm db:start` (Supabase local). En producción: los del proyecto Supabase nuevo.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Cuenta única (specs/002-cuenta-unica-portal): muestra "Ingresar con la cuenta única" (necesita la Edge Function cuenta-unica configurada).
VITE_CUENTA_UNICA=false
# Origen del portal: saludo del puente (rb-puente/1) y frame-ancestors del servidor de desarrollo. Vacío = fuera del portal.
VITE_PORTAL_ORIGEN=
