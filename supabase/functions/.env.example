# Secretos de las Edge Functions (local: copiar a supabase/functions/.env; producción: `supabase secrets set`).
# Cuenta única (contracts/cuenta-unica.md). Sin SSO_EMISOR la función cuenta-unica responde 404.
SSO_EMISOR=http://localhost:8080/realms/riberbulma
# Desde Docker `localhost` no es Keycloak: el canje del código y el JWKS van por el host de la VM (Colima/Docker Desktop).
SSO_EMISOR_INTERNO=http://host.docker.internal:8080/realms/riberbulma
SSO_CLIENTE=captacion
SSO_SECRETO=captacion-secreto-local
# URL pública de la callback, idéntica a un redirect_uri registrado en la cuenta única.
SSO_REDIRECCION=http://localhost:56321/functions/v1/cuenta-unica/callback
# Origen de la SPA (a dónde vuelve el navegador).
APP_URL=http://localhost:5180
